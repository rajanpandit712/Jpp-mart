# JPP Market – Client Environment Variables
# Copy this file to .env and fill in the actual values for your environment.
# NEVER commit your real .env file to source control.

# Backend API base URL
VITE_API_BASE_URL=http://localhost:5000/api

# Cloudinary (public config only — never put private keys here)
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_upload_preset

# Razorpay public key (key ID only — never put the secret here)
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
