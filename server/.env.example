# JPP Market – Server Environment Configuration
PORT=5000
NODE_ENV=development

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/jpp_market

# JWT authentication configuration
JWT_SECRET=jpp_market_super_secure_jwt_secret_dev_key_2026
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=jpp_market_super_refresh_secret_key_2026
JWT_REFRESH_EXPIRES_IN=30d

# Frontend client URL
CLIENT_URL=http://localhost:5173

# Cloudinary (Optional image hosting)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
